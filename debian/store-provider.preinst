#!/bin/sh
set -e

# this used to be in android-store part of andromeda. get rid of it if it still exists on the system
path="/usr/share/dbus-1/services/io.FuriOS.AndroidStore.service"
if [ -f $path ]; then
	owner=$(dpkg -S $path | cut -d ":" -f 1)
	if [ "$owner" = "android-store" ]; then
		rm -f $path
	fi
fi
