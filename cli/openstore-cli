#!/bin/bash

DB_PATH="$HOME/.local/store-provider/open-store/apps.db"
STORE_PATH="$HOME/.local/store-provider/open-store"
SCRIPTS_DIR="$HOME/.local/store-provider/open-store/scripts"
STORE_APPS_DIR="$HOME/.local/store-provider/open-store/applications"
SYSTEM_APPS_DIR="$HOME/.local/share/applications"

show_help() {
    echo "Usage: openstore-cli [COMMAND] [OPTIONS]"
    echo ""
    echo "Commands:"
    echo "  cleanup-desktop-files [DIR]  Remove broken desktop file symlinks in DIR"
    echo "                       (default: $HOME/.local/share/applications)"
    echo "                       Only removes symlinks pointing to $HOME/.local/store-provider"
    echo "  list-apps            List all installed apps from the OpenStore database"
    echo "  recreate-app APP_ID  Recreate desktop and script files for a specific app"
    echo "  recreate-all         Recreate desktop and script files for all installed apps"
    echo "  help                 Show this help message"
}

check_links() {
    # default to current dir if not set
    local dir="${1:-.}"

    if [ ! -d "$dir" ]; then
        echo "Error: Directory '$dir' does not exist." >&2
        exit 1
    fi

    local store_path="$HOME/.local/store-provider"
    local store_path_abs=$(readlink -f "$store_path")

    local total=0
    local store_links=0
    local broken=0

    while IFS= read -r symlink; do
        total=$((total + 1))

        local target=$(readlink -f "$symlink")
        local relative_target=$(readlink "$symlink")

        if [[ "$target" == "$store_path_abs"* ]]; then
            store_links=$((store_links + 1))

            if [ ! -e "$target" ]; then
                broken=$((broken + 1))
                echo "BROKEN: $symlink -> $relative_target (target does not exist)"
            else
                echo "VALID: $symlink -> $relative_target"
            fi
        fi
    done < <(find "$dir" -type l)

    echo ""
    echo "Summary:"
    echo "  Total symlinks found: $total"
    echo "  Symlinks pointing to $store_path: $store_links"
    echo "  Broken symlinks: $broken"

    if [ "$broken" -gt 0 ]; then
        return 1
    fi
    return 0
}

cleanup_desktop_files() {
    local dir="$HOME/.local/share/applications"

    if [[ $# -gt 0 ]]; then
        dir="$1"
    fi

    if [ ! -d "$dir" ]; then
        echo "Error: Directory '$dir' does not exist." >&2
        exit 1
    fi

    local store_path="$HOME/.local/store-provider"
    local store_path_abs=$(readlink -f "$store_path")

    local total=0
    local store_links=0
    local broken=0
    local removed=0

    echo "Cleaning up broken desktop file symlinks in $dir..."

    while IFS= read -r symlink; do
        total=$((total + 1))

        local target=$(readlink -f "$symlink")
        local relative_target=$(readlink "$symlink")

        if [[ "$target" == "$store_path_abs"* ]]; then
            store_links=$((store_links + 1))

            if [ ! -e "$target" ]; then
                broken=$((broken + 1))
                echo "REMOVING: $symlink -> $relative_target (target does not exist)"

                rm "$symlink"
                if [ $? -eq 0 ]; then
                    removed=$((removed + 1))
                fi
            else
                echo "VALID: $symlink -> $relative_target"
            fi
        fi
    done < <(find "$dir" -name "*.desktop" -type l)

    echo ""
    echo "Summary:"
    echo "  Total desktop file symlinks found: $total"
    echo "  Symlinks pointing to $store_path: $store_links"
    echo "  Broken symlinks found: $broken"
    echo "  Symlinks removed: $removed"

    return 0
}

recreate_app() {
    local app_id="$1"

    if [[ -z "$app_id" ]]; then
        echo "Error: No app ID specified." >&2
        return 1
    fi

    if ! command -v sqlite3 &> /dev/null; then
        echo "Error: sqlite3 command not found. Please install sqlite3." >&2
        return 1
    fi

    if [ ! -f "$DB_PATH" ]; then
        echo "Error: OpenStore database not found at $DB_PATH" >&2
        return 1
    fi

    local app_exists=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM installed_apps WHERE id='$app_id';")
    if [[ "$app_exists" -eq 0 ]]; then
        echo "Error: App with ID '$app_id' not found in the database." >&2
        return 1
    fi

    local app_info=$(sqlite3 "$DB_PATH" "SELECT id, name, version, channel, architecture, app_dir FROM installed_apps WHERE id='$app_id';")
    IFS='|' read -r id name version channel arch app_dir <<< "$app_info"

    if [ ! -d "$app_dir" ]; then
        echo "Error: App directory not found at $app_dir" >&2
        return 1
    fi

    echo "Recreating desktop files for $name ($app_id)..."
    echo "Cleaning up existing files for $app_id..."

    local pattern="${app_id}_*.desktop"
    local script_pattern="${app_id}_*.sh"

    find "$STORE_APPS_DIR" -name "$pattern" -exec rm -f {} \; 2>/dev/null
    find "$SYSTEM_APPS_DIR" -name "$pattern" -exec rm -f {} \; 2>/dev/null
    find "$SCRIPTS_DIR" -name "$script_pattern" -exec rm -f {} \; 2>/dev/null

    local desktop_files=$(find "$app_dir" -name "*.desktop" -type f)
    if [ -z "$desktop_files" ]; then
        echo "Warning: No desktop files found for $app_id in $app_dir" >&2
        return 0
    fi

    echo "$desktop_files" | while read -r desktop_file; do
        echo "Processing desktop file: $desktop_file"

        local desktop_filename=$(basename "$desktop_file")
        local script_basename="${app_id}_${desktop_filename%.desktop}"
        local script_path="$SCRIPTS_DIR/${script_basename}.sh"
        local store_desktop_path="$STORE_APPS_DIR/${app_id}_${desktop_filename}"
        local system_desktop_path="$SYSTEM_APPS_DIR/${app_id}_${desktop_filename}"

        local desktop_section=""
        local exec_cmd=""
        local app_name="$name"
        local icon=""

        while IFS= read -r line; do
            line=$(echo "$line" | xargs)
            if [[ "$line" == \[*\] ]]; then
                desktop_section="${line:1:-1}"
            elif [[ "$line" =~ ^Exec= && "$desktop_section" == "Desktop Entry" ]]; then
                exec_cmd="${line#Exec=}"
            elif [[ "$line" =~ ^Name= && "$desktop_section" == "Desktop Entry" ]]; then
                app_name="${line#Name=}"
            elif [[ "$line" =~ ^Icon= && "$desktop_section" == "Desktop Entry" ]]; then
                icon="${line#Icon=}"
            fi
        done < "$desktop_file"

        mkdir -p "$SCRIPTS_DIR"
        cat > "$script_path" << EOF
#!/bin/bash

# Script generated by OpenStore to launch app with the right environment variables

TRIPLET=\$(awk 'BEGIN{FS="[ ()-]"; "bash --version"|getline; OFS="-"; if (/bash/) print \$9,\$11,\$12}')

cd $app_dir

export LD_LIBRARY_PATH=\${PWD}/../lib:\${PWD}/lib:\${PWD}/usr/lib:\${PWD}/lib/\${TRIPLET}:\${PWD}/usr/lib/\${TRIPLET}:/usr/lib/\${TRIPLET}/furios-lomiri-app-support/lib:\${LD_LIBRARY_PATH}

export PATH=\${PWD}:\${PWD}/../bin:\${PWD}/bin:\${PWD}/usr/bin:\${PWD}/lib/bin:\${PWD}/lib/\${TRIPLET}/bin:/usr/lib/\${TRIPLET}/furios-lomiri-app-support/bin:\${PATH}

export QML2_IMPORT_PATH=\${PWD}/lib:\${PWD}/lib/\${TRIPLET}:\${PWD}/usr/lib/:\${PWD}/usr/lib/\${TRIPLET}/

export XDG_CACHE_HOME=\$HOME/.cache/

export UITK_ICON_THEME=suru

export APP_ID=${app_id}

gsettings set io.furios.phosh.shell appid '${app_id}_${desktop_filename}'

$exec_cmd
EOF
        chmod +x "$script_path"

        mkdir -p "$STORE_APPS_DIR"
        sed -e "s|^Exec=.*|Exec=$script_path|" \
            -e "s|^Path=.*|Path=$app_dir|" \
            "$desktop_file" > "$store_desktop_path"

        if [[ -n "$icon" && ! "$icon" =~ ^/ && ! "$icon" =~ ^\$ ]]; then
            icon_path="$app_dir/$icon"
            if [ -e "$icon_path" ]; then
                sed -i "s|^Icon=.*|Icon=$icon_path|" "$store_desktop_path"
            fi
        fi

        mkdir -p "$SYSTEM_APPS_DIR"
        ln -sf "$store_desktop_path" "$system_desktop_path"

        echo "Created desktop file and script for $app_name: $store_desktop_path"
    done

    echo "Desktop files for $app_id recreated successfully."
    return 0
}

recreate_all() {
    if ! command -v sqlite3 &> /dev/null; then
        echo "Error: sqlite3 command not found. Please install sqlite3." >&2
        return 1
    fi

    if [ ! -f "$DB_PATH" ]; then
        echo "Error: OpenStore database not found at $DB_PATH" >&2
        return 1
    fi

    local app_ids=$(sqlite3 "$DB_PATH" "SELECT id FROM installed_apps;")

    if [ -z "$app_ids" ]; then
        echo "No apps found in the database." >&2
        return 1
    fi

    local total_apps=$(echo "$app_ids" | wc -l)

    echo "Recreating desktop files for $total_apps apps..."

    while IFS= read -r app_id; do
        echo "==========================================="
        echo "Processing app: $app_id"
        recreate_app "$app_id"
        echo "==========================================="
        echo ""
    done <<< "$app_ids"

    echo "All desktop files have been recreated."
    return 0
}

list_apps() {
    if ! command -v sqlite3 &> /dev/null; then
        echo "Error: sqlite3 command not found. Please install sqlite3." >&2
        exit 1
    fi

    if [ ! -f "$DB_PATH" ]; then
        echo "Error: OpenStore database not found at $DB_PATH" >&2
        exit 1
    fi

    sqlite3 -header -column "$DB_PATH" "SELECT id, name, version, channel, architecture, app_dir FROM installed_apps;" | \
    while IFS='|' read -r id name version channel arch app_dir; do
        echo "$id | $name | $version | $channel | $arch | $app_dir"
    done

    return 0
}

case "$1" in
    cleanup-desktop-files)
        shift
        cleanup_desktop_files "$@"
        exit $?
        ;;
    list-apps)
        shift
        list_apps "$@"
        exit $?
        ;;
    recreate-app)
        shift
        recreate_app "$@"
        exit $?
        ;;
    recreate-all)
        shift
        recreate_all "$@"
        exit $?
        ;;
    help|--help|-h)
        show_help
        exit 0
        ;;
    "")
        echo "Error: No command specified." >&2
        show_help
        exit 1
        ;;
    *)
        echo "Error: Unknown command '$1'." >&2
        show_help
        exit 1
        ;;
esac
